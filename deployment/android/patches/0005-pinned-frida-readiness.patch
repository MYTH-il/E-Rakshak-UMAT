--- a/Dockerfile
+++ b/Dockerfile
@@ -70,6 +70,21 @@
   poetry cache clear . --all --no-interaction && \
   rm -rf /root/.cache/
 
+# ReDroid runs without Internet access in the default analysis mode. Keep the
+# Frida Python bindings and server exactly version-matched and verify the
+# downloaded server before it becomes part of the immutable analyzer image.
+ARG FRIDA_SERVER_VERSION=17.17.0
+ARG FRIDA_SERVER_SHA256=5f0671fbeaee0b1ee66b1536c3eae966d58765b7e3954ea49932e5931e43bd6c
+RUN test "$(python -c 'import frida; print(frida.__version__)')" = "$FRIDA_SERVER_VERSION" && \
+  mkdir -p /opt/frida-server && \
+  curl -fL --retry 3 \
+    -o /tmp/frida-server.xz \
+    "https://github.com/frida/frida/releases/download/${FRIDA_SERVER_VERSION}/frida-server-${FRIDA_SERVER_VERSION}-android-x86_64.xz" && \
+  echo "${FRIDA_SERVER_SHA256}  /tmp/frida-server.xz" | sha256sum -c - && \
+  python -c "import lzma,pathlib; pathlib.Path('/opt/frida-server/frida-server-${FRIDA_SERVER_VERSION}-android-x86_64').write_bytes(lzma.decompress(pathlib.Path('/tmp/frida-server.xz').read_bytes()))" && \
+  chmod 0755 "/opt/frida-server/frida-server-${FRIDA_SERVER_VERSION}-android-x86_64" && \
+  rm -f /tmp/frida-server.xz
+
 # Cleanup
 RUN \
     apt remove -y \

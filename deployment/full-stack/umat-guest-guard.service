[Unit]
Description=UMAT malware guest to control-plane firewall
After=network-online.target docker.service libvirtd.service
Before=umat-android-executor.service umat-windows-executor.service

[Service]
Type=oneshot
ExecStartPre=/usr/sbin/modprobe nft_ct
ExecStartPre=/usr/sbin/modprobe nft_nat
ExecStartPre=/usr/sbin/modprobe nft_masq
ExecStartPre=/usr/sbin/modprobe nft_limit
ExecStartPre=/usr/sbin/modprobe xt_mark
ExecStartPre=/usr/sbin/modprobe xt_comment
ExecStart=/usr/sbin/nft -f /etc/umat/umat-guest-guard.nft
ExecStartPost=/usr/libexec/umat/umat-guest-guard-compat start
ExecStop=/usr/libexec/umat/umat-guest-guard-compat stop
ExecStop=-/usr/sbin/nft delete table ip umat_guest_guard
ExecStop=-/usr/sbin/nft delete table ip6 umat_guest_guard6
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

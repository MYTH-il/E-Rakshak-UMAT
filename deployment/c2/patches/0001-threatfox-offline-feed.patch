+def import_threatfox(csv_path: str, db_path: str = _REP_DB) -> int:
+    """Import lookup-safe indicators from a ThreatFox full CSV export.
+
+    The C2 pipeline performs reputation lookups for destinations, so network
+    indicators are limited to active, non-compromised ``botnet_cc`` rows.
+    Payload-delivery and card-skimming hosts are deliberately excluded: they
+    frequently identify compromised or shared infrastructure and treating them
+    as C2 destinations would create false-positive attribution. Payload hashes
+    are retained as typed indicators for sample-reputation consumers.
+    """
+    if not os.path.exists(csv_path):
+        print(f"[!] File not found: {csv_path}")
+        return 0
+
+    import ipaddress
+    from urllib.parse import urlparse
+
+    conn = sqlite3.connect(db_path)
+    _ensure_schema(conn)
+    count = 0
+    hash_types = {
+        "md5_hash": "md5",
+        "sha1_hash": "sha1",
+        "sha256_hash": "sha256",
+    }
+
+    with open(csv_path, newline="", encoding="utf-8", errors="replace") as handle:
+        rows = csv.reader(
+            (line for line in handle if line.strip() and not line.startswith("#")),
+            skipinitialspace=True,
+        )
+        for row in rows:
+            if len(row) < 15 or row[0].strip().lower() == "first_seen_utc":
+                continue
+            first_seen, value, ioc_type, threat_type = (
+                row[0].strip(), row[2].strip(), row[3].strip().lower(), row[4].strip().lower()
+            )
+            malware = row[7].strip()
+            last_seen = row[8].strip() or first_seen
+            compromised = row[10].strip().lower() == "true"
+            indicator_type = hash_types.get(ioc_type)
+
+            if indicator_type:
+                if threat_type != "payload":
+                    continue
+                normalized = value.lower()
+            else:
+                if threat_type != "botnet_cc" or compromised:
+                    continue
+                if ioc_type == "domain":
+                    normalized = value.lower().rstrip(".")
+                    indicator_type = "domain"
+                elif ioc_type == "url":
+                    normalized = (urlparse(value).hostname or "").lower().rstrip(".")
+                    if not normalized:
+                        continue
+                    indicator_type = "ip" if _is_ip_literal(normalized) else "domain"
+                elif ioc_type == "ip:port":
+                    host = value.rsplit(":", 1)[0].strip("[]")
+                    try:
+                        normalized = str(ipaddress.ip_address(host))
+                    except ValueError:
+                        continue
+                    indicator_type = "ip"
+                else:
+                    continue
+
+                if indicator_type == "domain" and any(
+                        normalized == domain or normalized.endswith("." + domain)
+                        for domain in _SHARED_HOSTING):
+                    continue
+
+            if not normalized:
+                continue
+            note = f"{malware or 'Unknown malware'} {threat_type} ({ioc_type})"
+            conn.execute(
+                "INSERT OR REPLACE INTO bad_indicators "
+                "(value, source, note, indicator_type, last_seen) "
+                "VALUES (?, ?, ?, ?, ?)",
+                (normalized, "abuse.ch/ThreatFox", note, indicator_type, last_seen),
+            )
+            count += 1
+
+    conn.commit()
+    conn.close()
+    return count
+

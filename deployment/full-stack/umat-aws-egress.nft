flush ruleset

# Replace this documentation-only address with the operator's fixed public
# IPv4 address before installing the file on the sacrificial gateway.
define operator_ipv4 = 192.0.2.1

table inet umat_gateway {
  set prohibited_v4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4 }
  }

  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop
    iifname "ens5" ip saddr $operator_ipv4 udp dport 51820 accept
    iifname "wg0" ip saddr 10.77.0.2 ip daddr 10.77.0.53 udp dport 53 accept
    iifname "wg0" ip saddr 10.77.0.2 ip daddr 10.77.0.53 tcp dport 53 accept
    ip protocol icmp limit rate 5/second accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state invalid drop
    iifname "ens5" oifname "wg0" ct state established,related accept
    iifname "wg0" ip saddr 10.77.0.2 ip daddr @prohibited_v4 drop
    iifname "wg0" oifname "ens5" ip saddr 10.77.0.2 ip daddr 37.120.141.140 tcp dport 7775 ct state new limit rate 20/second burst 40 packets accept
    iifname "wg0" oifname "ens5" ip saddr 10.77.0.2 ip daddr 37.120.141.140 tcp dport 7775 ct state established accept
    iifname "wg0" oifname "ens5" ip saddr 10.77.0.2 tcp dport { 80, 443 } ct state new limit rate 20/second burst 40 packets accept
    iifname "wg0" oifname "ens5" ip saddr 10.77.0.2 tcp dport { 80, 443 } ct state established accept
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}

table ip umat_gateway_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "ens5" ip saddr 10.77.0.0/24 masquerade
  }
}

table ip umat_guest_guard {
    # Entries are created only by the root egress broker and expire in the
    # kernel if the executor/broker heartbeat stops.
    set windows_egress_v4 {
        type ipv4_addr
        flags timeout
        timeout 90s
        counter
    }

    set android_egress_v4 {
        type ipv4_addr
        flags timeout
        timeout 90s
        counter
    }

    chain input {
        # Run after the host's base firewall, which admits only tracked replies.
        # New guest-originated connections then reach the explicit rules below.
        type filter hook input priority 10; policy accept;

        iifname "virbr-winstdt" udp dport { 53, 67 } accept
        iifname "virbr-winstdt" tcp dport { 53, 2042 } accept
        # CAPE initiates guest control on TCP 8000; admit the fixed guest
        # source endpoint used for replies and reject every other host target.
        iifname "virbr-winstdt" ip saddr 10.66.0.101 tcp sport 8000 accept
        iifname "virbr-winstdt" drop

        # ReDroid's only host-side control channel is ADB on guest TCP 5555.
        # The guest has no default route; allow this fixed source endpoint and
        # drop every other guest-to-host packet below.
        iifname "br-umat-android" ip saddr 172.30.0.0/24 tcp sport 5555 accept
        iifname "br-umat-android" drop
        iifname "br-umat-egress" ip saddr 172.31.0.0/24 tcp sport 5555 accept
        iifname "br-umat-egress" drop
    }

    chain forward {
        type filter hook forward priority -5; policy accept;

        # Replies may return only from the dedicated WireGuard uplink.
        iifname "wg-umat-egress" oifname "virbr-winstdt" ip daddr @windows_egress_v4 ct state established,related meta mark set 0x554d accept
        iifname "wg-umat-egress" oifname "br-umat-egress" ip daddr @android_egress_v4 ct state established,related meta mark set 0x554d accept

        # DNS is forced to the recording resolver across the sacrificial VPN.
        iifname "virbr-winstdt" ip saddr @windows_egress_v4 ip daddr 10.77.0.53 oifname "wg-umat-egress" udp dport 53 meta mark set 0x554d accept
        iifname "virbr-winstdt" ip saddr @windows_egress_v4 ip daddr 10.77.0.53 oifname "wg-umat-egress" tcp dport 53 meta mark set 0x554d accept
        iifname "br-umat-egress" ip saddr @android_egress_v4 ip daddr 10.77.0.53 oifname "wg-umat-egress" udp dport 53 meta mark set 0x554d accept
        iifname "br-umat-egress" ip saddr @android_egress_v4 ip daddr 10.77.0.53 oifname "wg-umat-egress" tcp dport 53 meta mark set 0x554d accept

        # Never permit malware traffic toward any other local, management,
        # metadata or multicast range, even while a lease is active.
        iifname { "virbr-winstdt", "br-umat-android", "br-umat-egress" } ip daddr {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
            192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4
        } drop

        iifname "virbr-winstdt" ip saddr @windows_egress_v4 limit rate over 2 mbytes/second drop
        iifname "br-umat-egress" ip saddr @android_egress_v4 limit rate over 2 mbytes/second drop

        # Initial policy permits web traffic only and rate-limits new flows.
        iifname "virbr-winstdt" ip saddr @windows_egress_v4 oifname "wg-umat-egress" tcp dport { 80, 443 } ct state new limit rate 20/second burst 40 packets meta mark set 0x554d accept
        iifname "virbr-winstdt" ip saddr @windows_egress_v4 oifname "wg-umat-egress" tcp dport { 80, 443 } ct state established meta mark set 0x554d accept
        iifname "br-umat-egress" ip saddr @android_egress_v4 oifname "wg-umat-egress" tcp dport { 80, 443 } ct state new limit rate 20/second burst 40 packets meta mark set 0x554d accept
        iifname "br-umat-egress" ip saddr @android_egress_v4 oifname "wg-umat-egress" tcp dport { 80, 443 } ct state established meta mark set 0x554d accept

        iifname { "virbr-winstdt", "br-umat-android" } drop
        iifname "br-umat-egress" drop
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "virbr-winstdt" ip saddr @windows_egress_v4 udp dport 53 dnat to 10.77.0.53
        iifname "virbr-winstdt" ip saddr @windows_egress_v4 tcp dport 53 dnat to 10.77.0.53
        iifname "br-umat-egress" ip saddr @android_egress_v4 udp dport 53 dnat to 10.77.0.53
        iifname "br-umat-egress" ip saddr @android_egress_v4 tcp dport 53 dnat to 10.77.0.53
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "wg-umat-egress" ip saddr @windows_egress_v4 masquerade
        oifname "wg-umat-egress" ip saddr @android_egress_v4 masquerade
    }
}

# Malware guests never receive IPv6 egress. This also prevents bypassing the
# IPv4 destination policy when Docker/libvirt enables IPv6 in the future.
table ip6 umat_guest_guard6 {
    chain input {
        type filter hook input priority 10; policy accept;
        iifname { "virbr-winstdt", "br-umat-android" } drop
        iifname "br-umat-egress" drop
    }
    chain forward {
        type filter hook forward priority -5; policy accept;
        iifname { "virbr-winstdt", "br-umat-android" } drop
        iifname "br-umat-egress" drop
    }
}

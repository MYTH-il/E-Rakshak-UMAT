+        value = item.get("pretty_value") if item.get("pretty_value") is not None else item.get("value")
+        if value is not None:
+            values[str(item["name"])] = str(value)
+    return values
+
+
+def _bounded(value: Any, maximum: int) -> str | None:
+    if value is None:
+        return None
+    text = str(value).replace("\\x00", "").strip()
+    return text[:maximum] or None
+
+

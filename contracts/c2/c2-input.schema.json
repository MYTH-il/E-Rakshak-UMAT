{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://umat.local/contracts/c2/c2-input.schema.json",
  "type":"object",
  "required":["schema_version","analysis_run_id","platform","sample_sha256","pcap","analysis_window","guest_ip","access_events","static_prior","platform_manifest"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"type":"string","pattern":"^1\\.[0-9]+$"},
    "analysis_run_id":{"type":"string","format":"uuid"},
    "platform":{"enum":["windows","android"]},
    "sample_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "pcap":{"$ref":"#/$defs/artifact"},
    "analysis_window":{"type":"object","required":["started_at","ended_at"],"properties":{"started_at":{"type":"string","format":"date-time"},"ended_at":{"type":"string","format":"date-time"}},"additionalProperties":false},
    "guest_ip":{"type":["string","null"],"format":"ipvanyaddress"},
    "access_events":{"type":"object","required":["artifact_id","source","correlation_eligible"],"properties":{"artifact_id":{"type":["string","null"],"format":"uuid"},"source":{"enum":["etl_derived","unavailable"]},"correlation_eligible":{"type":"boolean"}},"additionalProperties":false},
    "static_prior":{"type":"object","required":["artifact_id"],"properties":{"artifact_id":{"type":["string","null"],"format":"uuid"}},"additionalProperties":false},
    "network_activity":{"type":"object","required":["artifact_id"],"properties":{"artifact_id":{"type":["string","null"],"format":"uuid"}},"additionalProperties":false},
    "platform_manifest":{"$ref":"#/$defs/artifact"}
  },
  "$defs":{"artifact":{"type":"object","required":["artifact_id","sha256"],"properties":{"artifact_id":{"type":"string","format":"uuid"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}}
}
